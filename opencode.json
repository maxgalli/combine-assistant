{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "combine": {
      "type": "remote",
      "url": "https://combine-mcp-git-combine-mcp.app.cern.ch/mcp",
      "enabled": true
    },
    "combine-run-remote": {
      "type": "remote",
      "url": "https://combine-run-mcp-git-combine-mcp.app.cern.ch/mcp",
      "enabled": true
    }
  },

  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow"
    }
  }
}

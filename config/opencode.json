{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CERN LiteLLM Gateway (CERN users — bring your own key)",
      "env": ["LITELLM_API_KEY"],
      "options": { "baseURL": "https://llmgw-litellm.web.cern.ch/v1" },
      "models": {
        "gpt-4.1": {
          "name": "GPT-4.1 (flagship)",
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 128000, "output": 8192 }
        },
        "mistral-small-latest": {
          "name": "Mistral Small (fast/cheap)",
          "tool_call": true,
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    },

    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic (public — bring your own key)",
      "env": ["ANTHROPIC_API_KEY"],
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": { "context": 200000, "output": 8192 }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": { "context": 200000, "output": 8192 }
        }
      }
    },

    "nrp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NRP Nautilus (research gateway — bring your own NRP token)",
      "options": {
        "baseURL": "https://ellm.nrp-nautilus.io/v1",
        "apiKey": "{env:NRP_API_KEY}"
      },
      "models": {
        "kimi": {
          "name": "Kimi (Moonshot, open-weight)",
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 262144, "output": 32768 },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "qwen3": {
          "name": "Qwen3 (NRP, reasoning on by default)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": { "context": 1010000, "output": 32768 },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "qwen3-small": {
          "name": "Qwen3 Small (NRP, faster)",
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 1010000, "output": 32768 },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        }
      }
    },

    "cern-vm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Combine-bot VM (self-hosted Ollama, no key)",
      "options": {
        "baseURL": "http://Combine-bot.cern.ch:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B (self-hosted)",
          "tool_call": true,
          "limit": { "context": 16384, "output": 8192 }
        }
      }
    }
  },

  "model": "litellm/gpt-4.1",
  "small_model": "litellm/mistral-small-latest",

  "mcp": {
    "combine": {
      "type": "remote",
      "url": "https://combine-mcp-git-combine-mcp.app.cern.ch/mcp",
      "enabled": true
    },
    "combine-run-remote": {
      "type": "remote",
      "url": "https://combine-run-mcp-git-combine-mcp.app.cern.ch/mcp",
      "enabled": true
    }
  },

  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow",
      "command -v *": "allow",
      "which *": "allow",
      "combine *": "allow",
      "text2workspace.py *": "allow",
      "combineCards.py *": "allow"
    }
  }
}

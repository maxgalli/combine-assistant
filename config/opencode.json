{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CERN LiteLLM Gateway (CERN users — bring your own key)",
      "env": ["LITELLM_API_KEY"],
      "options": { "baseURL": "https://llmgw-litellm.web.cern.ch/v1" },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (newest flagship)",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2026-07-01",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2026-07-01",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2026-07-01",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-5.5": {
          "name": "GPT-5.5 (stable flagship)",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2026-05-01",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2026-04-01",
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-5.3-chat-latest": {
          "name": "GPT-5.3 Chat (latest)",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2026-03-01",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.2": {
          "name": "GPT-5.2",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2026-02-01",
          "limit": { "context": 272000, "output": 128000 }
        },
        "gpt-5": {
          "name": "GPT-5",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2025-12-01",
          "limit": { "context": 272000, "output": 128000 }
        },
        "gpt-4.1": {
          "name": "GPT-4.1 (legacy flagship)",
          "tool_call": true,
          "temperature": true,
          "reasoning": false,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2025-06-01",
          "limit": { "context": 1047576, "output": 32768 }
        },
        "gpt-4.1-nano": {
          "name": "GPT-4.1 Nano (fast/cheap)",
          "tool_call": true,
          "temperature": true,
          "reasoning": false,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "release_date": "2025-06-01",
          "limit": { "context": 1047576, "output": 32768 }
        },
        "gpt-oss-20b": {
          "name": "GPT-OSS 20B (CERN self-hosted)",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "attachment": false,
          "release_date": "2025-08-01",
          "limit": { "context": 131072, "output": 32768 }
        },
        "mistral-small-latest": {
          "name": "Mistral Small (fast/cheap)",
          "tool_call": true,
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    },

    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic (public — bring your own key)",
      "env": ["ANTHROPIC_API_KEY"],
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": { "context": 200000, "output": 8192 }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": { "context": 200000, "output": 8192 }
        }
      }
    },

    "nrp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NRP Nautilus (research gateway — bring your own NRP token)",
      "options": {
        "baseURL": "https://ellm.nrp-nautilus.io/v1",
        "apiKey": "{env:NRP_API_KEY}"
      },
      "models": {
        "kimi": {
          "name": "Kimi (Moonshot, open-weight)",
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 262144, "output": 32768 },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "qwen3": {
          "name": "Qwen3 (NRP, reasoning on by default)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": { "context": 1010000, "output": 32768 },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "qwen3-small": {
          "name": "Qwen3 Small (NRP, faster)",
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 1010000, "output": 32768 },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        }
      }
    },

    "cern-vm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Combine-bot VM (self-hosted Ollama, no key)",
      "options": {
        "baseURL": "http://Combine-bot.cern.ch:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B (self-hosted)",
          "tool_call": true,
          "limit": { "context": 16384, "output": 8192 }
        }
      }
    }
  },

  "model": "litellm/gpt-5.5",
  "small_model": "litellm/gpt-4.1-nano",

  "mcp": {
    "combine": {
      "type": "remote",
      "url": "https://combine-mcp-git-combine-mcp.app.cern.ch/mcp",
      "enabled": true
    },
    "combine-run-remote": {
      "type": "remote",
      "url": "https://combine-run-mcp-git-combine-mcp.app.cern.ch/mcp",
      "enabled": true
    }
  },

  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow",
      "command -v *": "allow",
      "which *": "allow",
      "combine *": "allow",
      "text2workspace.py *": "allow",
      "combineCards.py *": "allow"
    }
  }
}
